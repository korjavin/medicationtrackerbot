# .env.openai.example

# Configure at least one of these variables to enable AI natural language food logging
# Example for standard OpenAI setup:
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override the OpenAI API base URL (defaults to https://api.openai.com/v1)
# Useful for compatible APIs like Groq, Ollama, vLLM, etc. which may not require an API key
# OPENAI_URL=http://localhost:11434/v1

# Optional: Override the OpenAI model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
