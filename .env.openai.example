# .env.openai.example

# Required to enable natural language food logging
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override the OpenAI API base URL (defaults to https://api.openai.com/v1)
# Useful for compatible APIs like Groq, Ollama, vLLM, etc.
# OPENAI_URL=https://api.openai.com/v1

# Optional: Override the OpenAI model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
