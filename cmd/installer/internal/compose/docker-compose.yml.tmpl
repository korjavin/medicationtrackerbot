services:
{{- if .Traefik }}
  traefik:
    image: traefik:v2.10
    container_name: medtracker-traefik
    restart: unless-stopped
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entryPoints.web.address=:80"
      - "--entryPoints.websecure.address=:443"
      - "--certificatesresolvers.myresolver.acme.httpchallenge=true"
      - "--certificatesresolvers.myresolver.acme.httpchallenge.entrypoint=web"
      - "--certificatesresolvers.myresolver.acme.email=${LE_EMAIL}"
      - "--certificatesresolvers.myresolver.acme.storage=/letsencrypt/acme.json"
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--entrypoints.web.http.redirections.entryPoint.scheme=https"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - letsencrypt_data:/letsencrypt
      - {{ .SocketPath }}:/var/run/docker.sock:ro
    networks:
      - {{ .NetworkName }}
{{ end }}
{{- if .PocketID }}
  pocket-id:
    image: ghcr.io/pocket-id/pocket-id:v1.14.2
    container_name: medtracker-pocket-id
    restart: unless-stopped
    ports:
      - "127.0.0.1:1411:1411"
    volumes:
      - pocketid_data:/app/backend/data
    environment:
      - APP_URL=https://${POCKET_ID_DOMAIN}
      - TRUST_PROXY=true
      - MAXMIND_LICENSE_KEY=
    networks:
      - default
      - {{ .NetworkName }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.pocket-id.rule=Host(`${POCKET_ID_DOMAIN}`)"
      - "traefik.http.routers.pocket-id.entrypoints=websecure"
      - "traefik.http.routers.pocket-id.tls.certresolver=myresolver"
      - "traefik.http.services.pocket-id.loadbalancer.server.port=1411"
      - "traefik.docker.network={{ .NetworkName }}"
{{ end }}
  medtracker:
    image: ghcr.io/korjavin/medicationtrackerbot:latest
    container_name: medtracker
    restart: unless-stopped
    volumes:
      - medtracker_data:/app/data
    env_file:
      - .env
    networks:
      - default
      - {{ .NetworkName }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.medtracker.rule=Host(`${DOMAIN}`)"
      - "traefik.http.routers.medtracker.entrypoints=websecure"
      - "traefik.http.routers.medtracker.tls.certresolver=myresolver"
      - "traefik.http.services.medtracker.loadbalancer.server.port=${PORT:-8080}"
      - "traefik.docker.network={{ .NetworkName }}"
{{- if .PocketID }}
    depends_on:
      - pocket-id
{{- end }}

{{- if .MCP }}

  mcp-server:
    image: ghcr.io/korjavin/medicationtrackerbot:latest
    container_name: medtracker-mcp
    restart: unless-stopped
    command: ["./mcptool"]
    volumes:
      - medtracker_data:/app/data:ro
    env_file:
      - .env.mcp
    environment:
      - ALLOWED_USER_ID=${ALLOWED_USER_ID}
      - SKIP_PERMS_FIX=true
      - TZ=${TZ:-Europe/Berlin}
      # APP_DOMAIN is the bot's public origin (with scheme); the MCP server uses
      # it as the CORS Allow-Origin and the trusted origin for the SDK's CSRF
      # protection. Must match the browser's Origin header exactly. Required for
      # the browser-side ElevenLabs client-tool callback path.
      - APP_DOMAIN=https://${DOMAIN}
    networks:
      - default
      - {{ .NetworkName }}
    labels:
      - "traefik.enable=true"
      {{- if eq .Config.MCP.Domain .Config.Domain }}
      - "traefik.http.routers.medtracker-mcp.rule=Host(`${DOMAIN}`) && (PathPrefix(`/mcp`) || PathPrefix(`/.well-known/oauth-protected-resource`))"
      {{- else }}
      - "traefik.http.routers.medtracker-mcp.rule=Host(`${MCP_DOMAIN}`)"
      {{- end }}
      - "traefik.http.routers.medtracker-mcp.entrypoints=websecure"
      - "traefik.http.routers.medtracker-mcp.tls.certresolver=myresolver"
      - "traefik.http.services.medtracker-mcp.loadbalancer.server.port=${MCP_PORT:-8081}"
      - "traefik.docker.network={{ .NetworkName }}"
{{- end }}


networks:
  {{ .NetworkName }}:
    name: {{ .NetworkName }}
    external: true

volumes:
  medtracker_data:
{{- if .Traefik }}
  letsencrypt_data:
{{- end }}
{{- if .PocketID }}
  pocketid_data:
{{- end }}
