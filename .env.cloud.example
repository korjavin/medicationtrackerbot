# Cloud-mode app stack (docker-compose.cloud.yml)
# Copy to .env next to that file and fill in before `docker compose up -d`.

# Base domain for wildcard-subdomain account routing (e.g. app.example.com).
# Must match the infra layer's CLOUD_BASE_DOMAIN.
CLOUD_BASE_DOMAIN=app.example.com

# Session cookie signing secret, >=32 chars with real entropy. Generate with:
# openssl rand -base64 32
SESSION_SECRET=

# Optional: VAPID JWT subject (RFC 8292) identifying the relay operator to
# push services. Defaults to mailto:noreply@<CLOUD_BASE_DOMAIN> if unset.
# VAPID_SUBJECT=mailto:you@example.com

# Optional: contact email shown on the base-domain landing page so a prospective
# user knows how to request an invite. Set = adds a "Contact us …" line with a
# mailto: link; unset = no contact line (default).
# REQUEST_INVITE_EMAIL=hello@example.com

# Days an admin invite link stays claimable before expiring.
CLOUD_CLAIM_TTL=14

# Per-account oplog+snapshot storage quota in bytes. The quota is ON by default
# (50MB) even if you delete this line — cmd/cloud seeds it and only a NON-EMPTY
# value overrides. Only an explicit `0` disables it, and then one runaway account
# can fill cloud_data and wedge writes for everyone else on the box.
# The server answers an over-quota write with 413, which the client shows as
# "Vault is full — new entries are not syncing" rather than as being offline.
CLOUD_ACCOUNT_QUOTA_BYTES=52428800

# Hours a scheduled push can sit unsent before the staleness sweep warns.
CLOUD_DRY_QUEUE_WARN_HOURS=120

# Operator's default food database (FastFoodDB-shaped). Required for food
# search to work on a fresh account — food is enabled by default, and with
# no DB configured the UI says "Food database not configured".
# CLOUD_FOOD_DB_URL=https://food.example.com

# Operator key for the food DB above, if it is keyed. Forwarded upstream as
# X-API-Key (same header bot mode sends from FOOD_API_KEY). Server-side only:
# it never reaches the browser. Leave unset for an unkeyed instance.
# CLOUD_FOOD_DB_API_KEY=

# age X25519 recipient public key served to the browser via a <meta> tag so the
# client can age-encrypt user feedback before POST /api/feedback (blind queue).
# Unset = feedback disabled: no meta tag (client hides the UI) and 503 responses.
# FEEDBACK_AGE_RECIPIENT=age1...

# SQLite database path inside the container.
CLOUD_DB_PATH=/app/data/cloud.db

# HTTP listen port inside the container.
PORT=8080

# --- Backups (litestream -> S3-compatible bucket) -------------------------
# cloud.db holds every account, device envelope, recovery verifier and all
# vault ciphertext. Zero-knowledge means the server ciphertext IS the vault:
# lose this volume and you lose everyone's data AND every recovery code at
# once. Do not run a real deployment without these set.
#
# The bucket holds ciphertext only, but that is everything an attacker needs
# for an offline brute-force. Use a PRIVATE bucket with its own credentials,
# scoped to this prefix and to no other stack.
#
# Leaving R2_BUCKET / LITESTREAM_ACCESS_KEY_ID unset makes the litestream
# container exit cleanly instead of crash-looping (fine for local dev only).
# Restore runbook: docs/cloud-deployment.md → Backups and restore.
# R2_BUCKET=medtracker-backups
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Object-key prefix inside the bucket. Must NOT collide with the bot stack's
# prefix (`medtracker`) if both replicate to the same bucket.
# LITESTREAM_PATH=medtracker-cloud

# How often WAL frames are uploaded. This is your worst-case data loss
# window (RPO): a crash loses at most this much. Lower = safer, more PUTs.
# LITESTREAM_SYNC_INTERVAL=1h

# --- Trial AI spend caps --------------------------------------------------
# TRIAL_RATE_PER_MIN (default 10) is a per-account sliding window: it smooths
# bursts and bounds nothing else. Five friends at 10 req/min sustained is 50
# req/min against YOUR OpenAI key, indefinitely, with the expensive food-photo
# vision calls sharing that limiter with cheap text ones.
#
# These two are the actual spend caps. They are persisted in cloud.db, so a
# redeploy does not hand everyone a fresh budget. 0 disables that scope.
# Exhaustion answers 429 {"error":"trial_budget_exhausted"}, and the app tells
# the user to add their own OpenAI key.
#
# NOTE: trial VOICE is not metered by these. Once a signed URL is minted the
# browser talks to ElevenLabs directly, so a mint cap would bound how many calls
# start, never how long they run. See bd med-d5t.5.
# TRIAL_DAILY_PER_ACCOUNT=100
# TRIAL_DAILY_GLOBAL=500
