<?xml version="1.0" encoding="utf-8"?>
<!-- Debug source set only (bd med-nt9p.32.1 spike): Auto Backup of the LOCAL origin's IndexedDB
     and nothing else — no account origin, no prefs, no Local Storage (shared across origins).
     Paths are relative to the data dir (domain="root"); the spike's #7 report lists the real
     app_webview names. Production rules are bd med-nt9p.32.5 (owner decision). -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="app_webview/Default/IndexedDB/https_appassets.androidplatform.net_0.indexeddb.leveldb" />
        <include domain="root" path="app_webview/Default/IndexedDB/https_appassets.androidplatform.net_0.indexeddb.blob" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/IndexedDB/https_appassets.androidplatform.net_0.indexeddb.leveldb" />
        <include domain="root" path="app_webview/Default/IndexedDB/https_appassets.androidplatform.net_0.indexeddb.blob" />
    </device-transfer>
</data-extraction-rules>
