<?xml version="1.0" encoding="utf-8"?>
<!-- Debug source set only (bd med-nt9p.24): the emulator QA harness trusts its runner CA from
     the user store. The release manifest is the main one, untouched. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Local-mode spike (bd med-nt9p.32.1): a second launcher icon, "Local spike". Backup rules
         are the main manifest's (bd med-nt9p.32.5), so the QA scenarios prove the shipped ones. -->
    <!-- android-qa's Health Connect writer (bd med-nt9p.59, QaHealthWrite.kt); granted by pm grant. -->
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" />
    <application
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".QaHealthWrite"
            android:exported="true" />
        <activity
            android:name=".LocalSpikeActivity"
            android:label="Local spike"
            android:taskAffinity="${applicationId}.localspike"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
