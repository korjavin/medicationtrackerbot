<?xml version="1.0" encoding="utf-8"?>
<!-- .wg-toggle: sunfill when on, the dark inset when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <size android:width="50dp" android:height="30dp" />
            <corners android:radius="15dp" />
            <gradient android:angle="270" android:startColor="@color/wg_sun_hi" android:endColor="@color/wg_sun_deep" />
            <stroke android:width="@dimen/wg_line_w" android:color="#33000000" />
        </shape>
    </item>
    <item>
        <shape>
            <size android:width="50dp" android:height="30dp" />
            <corners android:radius="15dp" />
            <solid android:color="@color/wg_toggle_off" />
            <stroke android:width="@dimen/wg_line_w" android:color="@color/wg_line_dark" />
        </shape>
    </item>
</selector>
