<?xml version="1.0" encoding="utf-8"?>
<!-- .wg-mark-lg: the 96dp app mark tile (ink, gloss, soft line, the sun pill) on the lock
     screen (N3); wg_splash_mark draws the same tile for the splash (N6). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="96dp" android:height="96dp">
        <shape>
            <corners android:radius="26dp" />
            <solid android:color="@color/wg_ink" />
            <stroke android:width="@dimen/wg_line_w" android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp">
        <shape>
            <corners android:radius="26dp" />
            <gradient android:angle="270" android:startColor="#29FFFFFF" android:centerColor="#00FFFFFF"
                android:centerY="0.52" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:width="46dp" android:height="46dp" android:gravity="center" android:drawable="@drawable/wg_mark_pill" />
</layer-list>
