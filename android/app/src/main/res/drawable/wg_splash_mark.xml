<?xml version="1.0" encoding="utf-8"?>
<!-- The splash icon (N6): a no-background splash icon is drawn at 288dp, so the 96dp mark tile
     centred in it lands at the size and spot of the lock screen's mark (N3). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape><solid android:color="#00000000" /></shape>
    </item>
    <item android:width="96dp" android:height="96dp" android:gravity="center" android:drawable="@drawable/wg_mark_lg" />
</layer-list>
