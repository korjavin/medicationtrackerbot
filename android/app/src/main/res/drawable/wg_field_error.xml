<?xml version="1.0" encoding="utf-8"?>
<!-- A field with an error (.wg-field-error): the danger line, focused or not. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/wg_radius_field" />
            <gradient android:angle="270" android:startColor="@color/wg_inset_a" android:endColor="@color/wg_inset_b" />
            <stroke android:width="@dimen/wg_line_w" android:color="@color/wg_danger_line" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/wg_radius_field" />
            <gradient android:angle="270" android:startColor="@color/wg_inset_a" android:endColor="@color/wg_inset_b" />
            <stroke android:width="@dimen/wg_line_w" android:color="@color/wg_danger_line" />
        </shape>
    </item>
</selector>
