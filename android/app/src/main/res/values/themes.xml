<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pinned dark, no DayNight (bd med-ckm5.14, screens-native.html token mirror): the window,
         the splash, every native screen and the system bars are wg_screen in light and dark mode
         alike, so a cold start never shows a white or grey frame (N6). -->
    <style name="Theme.MedTracker" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/wg_screen</item>
        <item name="android:colorBackground">@color/wg_screen</item>
        <item name="android:statusBarColor">@color/wg_screen</item>
        <item name="android:navigationBarColor">@color/wg_screen</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- Nothing falls back to the system accent (the iOS AccentColor twin). -->
        <item name="android:colorAccent">@color/wg_sun</item>
        <item name="android:colorControlActivated">@color/wg_sun</item>
        <item name="android:windowSplashScreenBackground">@color/wg_screen</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
