<?xml version="1.0" encoding="utf-8"?>
<!-- The native token mirror's widgets (bd med-ckm5.14): the kit classes of
     docs/design/claude-design/ui_kits/app-v2/components.css as plain-View styles (no Material,
     no appcompat). Views take them as defStyleRes (Wg.kt). Type in sp. -->
<resources>
    <!-- Text: Space Grotesk (wg_ui) unless noted. -->
    <style name="Widget.Wg.Text" parent="">
        <item name="android:fontFamily">@font/wg_ui</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/wg_fs_md</item>
        <item name="android:textColor">@color/wg_fg_1</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- wg-shell__title: JetBrains Mono 500, 28. -->
    <style name="Widget.Wg.Text.Title">
        <item name="android:fontFamily">@font/wg_mono</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/wg_fs_metric</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
        <item name="android:breakStrategy">balanced</item>
    </style>
    <!-- wg-shell__title-md: 22 (lock, load error). -->
    <style name="Widget.Wg.Text.Title.Md">
        <item name="android:textSize">@dimen/wg_fs_title</item>
    </style>
    <style name="Widget.Wg.Text.Lede">
        <item name="android:textSize">@dimen/wg_fs_lg</item>
        <item name="android:textColor">@color/wg_fg_2</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="Widget.Wg.Text.Note">
        <item name="android:textSize">@dimen/wg_fs_sm</item>
    </style>
    <!-- wg-meta: the load error's mono status line for support. -->
    <style name="Widget.Wg.Text.Meta">
        <item name="android:fontFamily">@font/wg_mono</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/wg_fs_xs</item>
        <item name="android:textColor">@color/wg_fg_3</item>
    </style>

    <!-- wg-btn: raised + 1dp line. Height grows and the label wraps at large font scales. -->
    <style name="Widget.Wg.Button" parent="">
        <item name="android:background">@drawable/wg_btn_raised</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">@dimen/wg_hit</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/wg_ui</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/wg_fs_md</item>
        <item name="android:textColor">@color/wg_fg_1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <!-- wg-btn-primary wg-btn-lg: the sun, 52 high, radius 14. One per screen. -->
    <style name="Widget.Wg.Button.Primary">
        <item name="android:background">@drawable/wg_btn_primary</item>
        <item name="android:minHeight">@dimen/wg_primary_h</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">@dimen/wg_fs_lg</item>
        <item name="android:textColor">@color/wg_on_sun</item>
    </style>
    <!-- wg-btn-ghost: fg-2 text, no fill. -->
    <style name="Widget.Wg.Button.Ghost">
        <item name="android:background">@drawable/wg_btn_ghost</item>
        <item name="android:textColor">@color/wg_fg_2</item>
    </style>
    <!-- wg-btn-ghost wg-btn-sm: 36 high, 13sp (Copy diagnostics). -->
    <style name="Widget.Wg.Button.Ghost.Sm">
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">@dimen/wg_fs_sm</item>
    </style>



    <!-- wg-note: the container LinearLayout; the tone sets fill and line. -->
    <style name="Widget.Wg.Note" parent="">
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="Widget.Wg.Note.Info">
        <item name="android:background">@drawable/wg_note_info</item>
    </style>
    <style name="Widget.Wg.Note.Warn">
        <item name="android:background">@drawable/wg_note_warn</item>
    </style>
    <style name="Widget.Wg.Note.Danger">
        <item name="android:background">@drawable/wg_note_danger</item>
    </style>
</resources>
