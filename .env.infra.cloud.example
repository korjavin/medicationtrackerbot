# Cloud-mode infra layer (docker-compose.infra.cloud.yml)
# Copy to .env next to that file and fill in before `docker compose up -d`.

# Base domain for the wildcard cert and subdomain routing (e.g. app.example.com).
# DNS records for both `<base>` and `*.<base>` must point at this server.
CLOUD_BASE_DOMAIN=app.example.com

# Email Let's Encrypt uses for expiry/abuse notices.
ACME_EMAIL=you@example.com

# Cloudflare API token scoped to Zone -> DNS -> Edit, single zone (the zone
# containing CLOUD_BASE_DOMAIN). Do not use your Global API Key.
CF_DNS_API_TOKEN=

# DNS-01 provider for the wildcard cert. Only needed if not using Cloudflare;
# see https://go-acme.github.io/lego/dns/ for the provider name and the env
# vars it expects (swap CF_DNS_API_TOKEN above for that provider's vars too).
# DNS_PROVIDER=cloudflare
