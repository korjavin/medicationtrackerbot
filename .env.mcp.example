# MCP Server Configuration
# Add these to your .env file

MCP_PORT=8081
MCP_DATABASE_PATH=/app/data/meds.db
MCP_MAX_QUERY_DAYS=90
MCP_SERVER_URL=https://mcp.yourdomain.com
MCP_DOMAIN=mcp.yourdomain.com
MCP_ALLOWED_SUBJECT=your-pocket-id-user-uuid

# APP_DOMAIN is the bot's public origin including scheme. The MCP server uses
# it as the CORS Allow-Origin and as the trusted origin for the SDK's
# CrossOriginProtection — it must match the browser's Origin header exactly.
# Required for the browser-side ElevenLabs client-tool callback path; leave
# empty to disable cross-origin browser access.
APP_DOMAIN=https://yourdomain.com

# Audit Notifications (Optional)
MCP_AUDIT_ENDPOINT=http://medtracker:8080/api/mcp-audit
MCP_AUDIT_SECRET=generate-a-secure-random-secret-here

# Pocket-ID Configuration
POCKET_ID_URL=https://id.yourdomain.com
POCKET_ID_CLIENT_ID=your-client-id
POCKET_ID_CLIENT_SECRET=your-client-secret
