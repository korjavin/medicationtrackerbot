{
  "_doc": "iOS visual QA scenes (docs/design/ios-visual-testing.md). nativeOnly (default: name starts with native-) = no -wgLocalMode, no driver. steps (tab | click | tag: give the first visible match a DOM id for a native tap | settingsPage | file: put a picked file, content text (default {}), on that <input type=file> | consent: open that TrialConsent sheet | firstrun: open the W1 first-run picker over the seeded vault, or W2 with \"trial\") and ready (selectors that must be visible): the in-page driver (tests/visual/driver.js). native: XCUITest steps after #wg-qa-ready (ios/UITests): tap (DOM id or placeholder), type, clear, tapButton (label), waitFor (label or id), keyboard (wait for the software keyboard). Page scenes (Settings) open from Today first: a page keeps its origin tab lit, and each load restores the previous scene's tab, so without it Settings would light whatever ran before (med-e6ql). The page clock reads today 23:00 local (driver.js pinClock), so time-dependent text is stable. mask (optional): [{x, y, w, h}] fractions of the image that tests/visual/compare.mjs blanks before diffing (regions that still change run to run). localOnly: the cloud pass skips it. cloudOnly: the local passes (Playwright local, the iOS Simulator) skip it. platform (optional, \"ios\"): only that shell runs it. args (optional, native scenes): extra launch arguments, a `-key` here replacing the base one (Dynamic Type; the Debug-only -wgQAMovePending, -wgQALock failed|cancelled, -wgQALoadError 503|404|local, -wgQAHoldMark). settings-erase-confirm, settings-replace-confirm and settings-delete-confirm only open their typed-confirm dialogs (they never type the word); journey turns gamification ON for the device, so it stays last.",
  "version": 1,
  "scenes": [
    { "name": "native-firstrun", "native": [] },
    { "name": "native-local-intro", "native": [{ "tapButton": "Only on this device" }] },
    { "name": "native-firstrun-error", "native": [{ "tapButton": "Continue" }] },
    { "name": "native-firstrun-move", "platform": "ios", "args": ["-wgQAMovePending", "YES"] },
    { "name": "native-local-intro-move", "platform": "ios", "args": ["-wgQAMovePending", "YES"],
      "native": [{ "tapButton": "Only on this device" }] },
    { "name": "native-firstrun-2x", "platform": "ios",
      "args": ["-UIPreferredContentSizeCategoryName", "UICTContentSizeCategoryAccessibilityL"] },
    { "name": "native-lock", "platform": "ios",
      "args": ["-wgLocalMode", "YES", "-wgLocalLockOn", "YES", "-wgLocalLock", "YES", "-wgQALock", "cancelled"] },
    { "name": "native-lock-failed", "platform": "ios",
      "args": ["-wgLocalMode", "YES", "-wgLocalLockOn", "YES", "-wgLocalLock", "YES", "-wgQALock", "failed"] },
    { "name": "native-error-503", "platform": "ios", "args": ["-wgQALoadError", "503"] },
    { "name": "native-error-404", "platform": "ios", "args": ["-wgQALoadError", "404"] },
    { "name": "native-error-local", "platform": "ios", "args": ["-wgLocalMode", "YES", "-wgLocalLockOn", "NO", "-wgQALoadError", "local"] },
    { "name": "native-launch", "platform": "ios", "args": ["-wgQAHoldMark", "YES"] },
    { "name": "today", "steps": [{ "tab": "today" }],
      "ready": ["#today-view.active", "#today-content > *"] },
    { "name": "food-log", "steps": [{ "tab": "food" }],
      "ready": ["#food-view.active", "#food-list > *"] },
    { "name": "food-add-sheet", "steps": [{ "tab": "food" }, { "click": "#add-food-inline-btn" }],
      "ready": ["#food-add-sheet", "#food-add-search"] },
    { "name": "food-add-sheet-keyboard", "steps": [{ "tab": "food" }, { "click": "#add-food-inline-btn" }],
      "ready": ["#food-add-sheet", "#food-add-search"],
      "native": [
        { "tap": "#food-add-search", "placeholder": "Search your foods and the database" },
        { "type": "Gre" },
        { "keyboard": true }
      ] },
    { "name": "food-add-sheet-keyboard-empty", "steps": [{ "tab": "food" }, { "click": "#add-food-inline-btn" }],
      "ready": ["#food-add-sheet", "#food-add-search"],
      "native": [
        { "tap": "#food-add-search", "placeholder": "Search your foods and the database" },
        { "type": "Gre" },
        { "clear": true },
        { "keyboard": true }
      ] },
    { "name": "meds-schedule", "steps": [{ "tab": "meds" }, { "click": ".med-tab[data-tab=\"schedule\"]" }],
      "ready": ["#med-schedule-tab.active", "#med-list > *"] },
    { "name": "workouts-plans", "steps": [{ "tab": "workouts" }, { "click": ".workout-tab[data-tab=\"groups\"]" }],
      "ready": ["#workout-groups-tab.active", "#workout-groups-list > *"] },
    { "name": "workouts-stats", "steps": [{ "tab": "workouts" }, { "click": ".workout-tab[data-tab=\"stats\"]" }, { "click": ".wg-workouts-stats__view [data-view=\"load\"]" }],
      "ready": ["#workout-stats-tab.active", "#workout-stats-display .wg-workout-chart"] },
    { "name": "workout-session-log",
      "steps": [
        { "tab": "workouts" }, { "click": ".workout-tab[data-tab=\"history\"]" }, { "click": ".wg-workouts-history-row" },
