      ],
      "ready": ["#wg-qa-reps"],
      "native": [
        { "tap": "#wg-qa-reps" },
        { "keyboard": true }
      ] },
    { "name": "health-bp", "steps": [{ "tab": "bp" }],
      "ready": ["#bp-view.active", "#bpChart svg"] },
    { "name": "health-vitals", "steps": [{ "tab": "health" }],
      "ready": ["#health-view.active", "#health-overview-content"] },
    { "name": "settings-home", "steps": [{ "tab": "today" }, { "tab": "settings" }],
      "ready": ["#settings-view.active"] },
    { "name": "settings-backup", "steps": [{ "tab": "today" }, { "tab": "settings" }, { "settingsPage": "backup" }],
      "ready": [".wg-pagebar", "#settings-importexport"] },
    { "name": "settings-notifications", "steps": [{ "tab": "today" }, { "tab": "settings" }, { "settingsPage": "notifications" }],
      "ready": [".wg-pagebar--long", "#settings-reminders-meds"] },
    { "name": "weight", "steps": [{ "tab": "weight" }],
      "ready": ["#weight-view.active", "#weightChart > *", "#weight-list > *"] },
    { "name": "meds-history-take",
      "steps": [{ "tab": "meds" }, { "click": ".med-tab[data-tab=\"history\"]" }, { "click": "#history-list .wg-meds-history__row.cursor-pointer" }],
      "ready": ["#med-confirm-modal", "#med-confirm-list > *"] },
    { "name": "settings-targets-keyboard",
      "steps": [{ "tab": "today" }, { "tab": "settings" }, { "settingsPage": "targets" }, { "tag": "#food-target-calories", "id": "wg-qa-calories" }],
      "ready": ["#food-target-calories"],
      "native": [{ "tap": "#wg-qa-calories", "placeholder": "1700" }, { "keyboard": true }] },
    { "name": "settings-ai-key-keyboard",
      "steps": [{ "tab": "today" }, { "tab": "settings" }, { "settingsPage": "integrations" }, { "tag": "#integrations-openai-api-key", "id": "wg-qa-api-key" }],
      "ready": ["#integrations-openai-api-key"],
      "native": [{ "tap": "#wg-qa-api-key", "placeholder": "sk-..." }, { "keyboard": true }] },
    { "name": "settings-erase-confirm", "localOnly": true,
      "steps": [{ "tab": "today" }, { "tab": "settings" }, { "settingsPage": "backup" }, { "click": "#importexport-local-erase-btn" }],
      "ready": [".mt-confirm-modal", ".mt-confirm-modal .mt-confirm-modal__confirm"] },
    { "name": "settings-replace-confirm",
      "steps": [{ "tab": "today" }, { "tab": "settings" }, { "settingsPage": "backup" }, { "file": "#importexport-import-file" }, { "click": "#importexport-import-btn" }],
      "ready": [".mt-confirm-modal .wg-dialog__facts", ".mt-confirm-modal .wg-dialog__confirm"] },
    { "name": "settings-delete-confirm", "cloudOnly": true,
      "steps": [{ "tab": "today" }, { "tab": "settings" }, { "settingsPage": "account" }, { "click": "#delete-account-open" }],
      "ready": [".mt-confirm-modal .wg-dialog__facts", ".mt-confirm-modal .wg-dialog__confirm"] },
    { "name": "trial-consent", "localOnly": true,
      "steps": [{ "tab": "today" }, { "consent": "anon" }],
      "ready": ["#trial-consent-modal-anon .wg-facts", "#trial-consent-modal-anon [data-trial-consent-choice=\"allow\"]"] },
    { "name": "firstrun-w1",
      "steps": [{ "tab": "today" }, { "firstrun": true }],
      "ready": ["#wg-firstrun-overlay [data-firstrun-feature=\"diary\"]", "#wg-firstrun-overlay [data-firstrun-action=\"continue\"]"] },
    { "name": "firstrun-w2",
      "steps": [{ "tab": "today" }, { "firstrun": "trial" }],
      "ready": ["#wg-firstrun-overlay [data-firstrun-example]", "#wg-firstrun-overlay [data-firstrun-action=\"not-now\"]"] },
    { "name": "journey",
      "steps": [{ "tab": "today" }, { "tab": "settings" }, { "settingsPage": "features" }, { "click": "#gamification-feature-toggle:not(:checked)" }, { "click": ".wg-page .wg-back" }, { "tab": "today" }, { "tab": "journey" }],
      "ready": ["#journey-view.active", "#journey-content > *"] },
    { "name": "today-ai-trial", "localOnly": true,
      "steps": [{ "trial": { "on": false } }, { "tab": "settings" }, { "tab": "today" }],
      "ready": ["#today-content [data-section=\"ai-trial\"] [data-action=\"ai-trial-start\"]"] },
    { "name": "settings-ai-trial", "localOnly": true,
      "steps": [{ "trial": { "on": true, "remaining": 42, "daily": 50, "voiceRemaining": 1080, "voiceLifetime": 1800, "voiceDaily": 600, "voiceDailyRemaining": 420, "voiceCallMax": 300 } }, { "tab": "today" }, { "tab": "settings" }, { "settingsPage": "integrations" }],
      "ready": ["#integrations-trial-card [data-trial-state=\"on\"] .wg-macros"] }
  ]
